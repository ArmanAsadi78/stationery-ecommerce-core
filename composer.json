{
  "name": "stationery/ecommerce-core",
  "description": "High-Performance Clean MVC E-Commerce Engine for Stationery Store (PHP 8.2+, MySQL, FastRoute, Twig, PHPUnit)",
  "type": "project",
  "license": "MIT",
  "keywords": ["ecommerce", "php", "mvc", "clean-architecture", "fastroute", "twig", "stationery", "torob-integration"],
  "authors": [
    {
      "name": "Arman Asadi",
      "email": "arman.asadi2019pc@gmail.com",
      "role": "Lead Software Engineer"
    }
  ],
  "require": {
    "php": ">=8.2.0",
    "nikic/fast-route": "^1.3",
    "twig/twig": "^3.14",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^10.5",
    "phpstan/phpstan": "^1.12 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Core/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "process-timeout": 600
  },
  "scripts": {
    "test": "phpunit --testdox",
    "analyse": "phpstan analyse app tests --level=6",
    "migrate": "php database/migrate.php",
    "seed": "php database/seeders/DatabaseSeeder.php",
    "generate:placeholders": "php database/generate_placeholders.php"
  }
}
