{% extends 'layouts/base.twig' %}

{% block content %}
<div class="container">
    {# ================================================================= #}
    {# 1. UNIFIED WIDE BANNER SLIDER (Similar to Hiss / Digikala)        #}
    {# ================================================================= #}
    <section class="hero-banner-section" data-aos="fade-up">
        <div class="hero-banner-slider" id="heroBannerSlider">
            <div class="hero-banner-track" id="heroBannerTrack">
                {% if sliders is defined and sliders|length > 0 %}
                    {% for slider in sliders %}
                        <a href="{{ url(slider.target_url|default(slider.link|default('/'))) }}" class="hero-banner-slide {% if loop.first %}active{% endif %}" data-slide-index="{{ loop.index0 }}" aria-label="{{ slider.title }}">
                            <img src="{{ asset(slider.image_path|default(slider.image_url)) }}" alt="{{ slider.title }}" class="hero-banner-img" width="1200" height="420" loading="{% if loop.first %}eager{% else %}lazy{% endif %}">
                        </a>
                    {% endfor %}
                {% else %}
                    <a href="{{ url('products') }}" class="hero-banner-slide active" data-slide-index="0" aria-label="فروشگاه لوازم‌التحریر تحریرچی">
                        <img src="{{ asset('images/sliders/banner-1.webp') }}" alt="جشنواره نوشت‌افزار تحریرچی" class="hero-banner-img" width="1200" height="420" loading="eager">
                    </a>
                {% endif %}
            </div>

            {% if sliders is defined and sliders|length > 1 %}
                <!-- Navigation Arrows (Previous is Right, Next is Left in RTL) -->
                <button type="button" class="hero-slider-arrow hero-arrow-prev" id="heroSliderPrev" aria-label="بنر قبلی" title="قبلی">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                <button type="button" class="hero-slider-arrow hero-arrow-next" id="heroSliderNext" aria-label="بنر بعدی" title="بعدی">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>

                <!-- Indicator Dots -->
                <div class="hero-slider-dots" id="heroSliderDots">
                    {% for slider in sliders %}
                        <button type="button" class="hero-slider-dot {% if loop.first %}active{% endif %}" data-index="{{ loop.index0 }}" aria-label="رفتن به اسلاید {{ loop.index|fa_num }}"></button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    {# ================================================================= #}
    {# 2. CIRCULAR STORY CATEGORIES (Pastel Story Bubbles)               #}
    {# ================================================================= #}
    <section class="story-categories-section" data-aos="fade-up">
        <div class="story-categories-header">
            <div>
                <h2 class="story-section-title">💖 دسته‌بندی‌های محبوب و رنگی‌رنگی</h2>
                <p class="story-section-hint">روی دسته‌بندی مورد علاقه خود بزنید تا فانتزی‌ترین‌ها را ببینید</p>
            </div>
            <a href="{{ url('products') }}" class="story-view-all">مشاهده همه ←</a>
        </div>

        <div class="story-categories-track">
            {% for cat in popular_categories %}
                {% set badgeClasses = ['badge-pink', 'badge-lavender', 'badge-mint', 'badge-butter', 'badge-sky', 'badge-peach'] %}
                {% set badgeClass = badgeClasses[loop.index0 % 6] %}
                <a href="{{ url('products?category=' ~ cat.slug) }}" class="story-cat-item" data-aos="zoom-in" data-aos-delay="{{ loop.index * 50 }}">
                    <div class="story-circle category-bubble">
                        <div class="story-inner-badge {{ badgeClass }}">
                            {% if cat.icon_image %}
                                <img src="{{ asset(cat.icon_image) }}" alt="{{ cat.title }}" class="story-icon-img" width="64" height="64" loading="lazy">
                            {% else %}
                                <span class="story-emoji">📁</span>
                            {% endif %}
                        </div>
                    </div>
                    <span class="story-label">{{ cat.title }}</span>
                </a>
            {% else %}
                <a href="{{ url('products') }}" class="story-cat-item">
                    <div class="story-circle category-bubble">
                        <div class="story-inner-badge badge-pink">
                            <span class="story-emoji">✏️</span>
                        </div>
                    </div>
                    <span class="story-label">همه محصولات</span>
                </a>
            {% endfor %}
        </div>
    </section>

    {# ================================================================= #}
    {# 3. PROMO TILES (Commercial Composite Images & Clean Cards)        #}
    {# ================================================================= #}
    <section class="promo-tiles-section" data-aos="fade-up">
        <div class="promo-grid">
            {% set rBanner = promo_banners.banner_right|default(null) %}
            {% if rBanner and rBanner.is_active %}
                <div class="promo-tile promo-tile-peach" data-tilt data-tilt-max="12" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.15" data-aos="zoom-in" data-aos-delay="100">
                    <div class="promo-content">
                        <span class="promo-badge">{{ rBanner.badge_text }}</span>
                        <h3 class="promo-title">{{ rBanner.title }}</h3>
                        <p class="promo-desc">{{ rBanner.description }}</p>
                        <a href="{{ url(rBanner.target_url) }}" class="promo-btn">{{ rBanner.button_text }}</a>
                    </div>
                    <div class="promo-banner-media promo-art-box">
                        <img src="{{ asset(rBanner.image_path) }}" alt="{{ rBanner.title }}" class="promo-banner-img promo-composite-img" loading="lazy" width="500" height="350">
                    </div>
                </div>
            {% endif %}

            {% set lBanner = promo_banners.banner_left|default(null) %}
            {% if lBanner and lBanner.is_active %}
                <div class="promo-tile promo-tile-lavender" data-tilt data-tilt-max="12" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.15" data-aos="zoom-in" data-aos-delay="200">
                    <div class="promo-content">
                        <span class="promo-badge">{{ lBanner.badge_text }}</span>
                        <h3 class="promo-title">{{ lBanner.title }}</h3>
                        <p class="promo-desc">{{ lBanner.description }}</p>
                        <a href="{{ url(lBanner.target_url) }}" class="promo-btn">{{ lBanner.button_text }}</a>
                    </div>
                    <div class="promo-banner-media promo-art-box">
                        <img src="{{ asset(lBanner.image_path) }}" alt="{{ lBanner.title }}" class="promo-banner-img promo-composite-img" loading="lazy" width="500" height="350">
                    </div>
                </div>
            {% endif %}
        </div>
    </section>

    {# ================================================================= #}
    {# ================================================================= #}
    {# 4. INTERACTIVE PRODUCT CAROUSEL (Commercial Rich Cards)           #}
    {# ================================================================= #}
    <section class="featured-section" data-aos="fade-up">
        <div class="section-header">
            <div>
                <h2 class="section-title">✨ محصولات منتخب و شگفت‌انگیز تحریرچی</h2>
                <p class="section-subtitle">پرفروش‌ترین‌های این هفته با تخفیف ویژه و بسته‌بندی اختصاصی</p>
            </div>
            <a href="{{ url('products') }}" class="view-all-link">
                <span>مشاهده کاتالوگ کامل</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </a>
        </div>

        <!-- Horizontal Product Carousel -->
        <div class="product-carousel-wrapper">
            <!-- Navigation Button Right (Prev in RTL) -->
            <button type="button" class="carousel-nav-btn carousel-prev" id="carouselPrevBtn" aria-label="محصولات قبلی" title="قبلی">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
            </button>

            <!-- Carousel Track with Swipe / Drag & Snap -->
            <div class="product-carousel-track" id="featuredCarouselTrack">
                {% for product in featured_products %}
                    <article class="product-card carousel-slide {% if product.stock_quantity <= 0 %}out-of-stock{% endif %}">
                        <div class="product-thumb">
                            <a href="{{ url('products/' ~ product.slug) }}" class="thumb-link">
                                <img src="{{ product.primary_image ? asset(product.primary_image) : asset('images/placeholder.webp') }}" alt="{{ product.title }}" loading="lazy">
                            </a>

                            <!-- Wishlist Heart Button -->
                            <button type="button" class="btn-wishlist" data-id="{{ product.id }}" title="افزودن به علاقه‌مندی‌ها" aria-label="علاقه‌مندی">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                                </svg>
                            </button>

                            <div class="product-badges-wrap">
                                {% if product.compare_at_price and product.compare_at_price > product.price %}
                                    {% set discount = ((product.compare_at_price - product.price) / product.compare_at_price * 100)|round %}
                                    <span class="badge-discount">🔥 {{ discount|fa_num }}% تخفیف</span>
                                {% elseif product.is_featured %}
                                    <span class="badge-featured">⭐ محبوب</span>
                                {% endif %}

                                {% if product.stock_quantity <= 0 %}
                                    <span class="badge-out-of-stock">ناموجود</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="product-info-wrap">
                            <span class="product-category-brand">{{ product.brand ?? 'تحریرچی' }} · {{ product.category_title }}</span>

                            <!-- 5-Star Commercial Rating Row -->
                            <div class="product-rating-row">
                                <div class="rating-stars" aria-label="امتیاز ۵ از ۵">
                                    <span class="star-gold">★</span>
                                    <span class="star-gold">★</span>
                                    <span class="star-gold">★</span>
                                    <span class="star-gold">★</span>
                                    <span class="star-gold">★</span>
                                </div>
                                <span class="rating-val">{{ (4.7 + ((product.id * 3) % 4) * 0.1)|number_format(1, '.')|fa_num }}</span>
                                <span class="rating-count">({{ (15 + (product.id * 17) % 65)|fa_num }})</span>
                            </div>

                            <h3 class="product-title">
                                <a href="{{ url('products/' ~ product.slug) }}" title="{{ product.title }}">{{ product.title }}</a>
                            </h3>

                            {# Low Stock Urgency Indicator (<= 5 items) #}
                            {% if product.stock_quantity > 0 and product.stock_quantity <= 5 %}
                                <div class="product-stock-urgency">
                                    <span class="urgency-dot"></span>
                                    <span>تنها {{ product.stock_quantity|fa_num }} عدد در انبار باقی مانده!</span>
                                </div>
                            {% endif %}

                            {# Color Swatch Dots for products with variants #}
                            {% if product.variants is defined and product.variants|length > 0 %}
                                <div class="product-color-dots" title="تنوع رنگی موجود">
                                    {% set shownColors = [] %}
                                    {% for v in product.variants %}
                                        {% if v.color_hex and v.color_hex not in shownColors %}
                                            {% set shownColors = shownColors|merge([v.color_hex]) %}
                                            <span class="color-swatch-dot" style="background-color: {{ v.color_hex }};" title="{{ v.attribute_value }}"></span>
                                        {% endif %}
                                    {% endfor %}
                                    <span class="color-count-label">{{ product.variants|length|fa_num }} تنوع</span>
                                </div>
                            {% else %}
                                <div class="product-color-placeholder"></div>
                            {% endif %}

                            <div class="product-pricing">
                                <div class="price-box">
                                    <span class="price-current">{{ product.price|price }}</span>
                                    {% if product.compare_at_price and product.compare_at_price > product.price %}
                                        <span class="price-old">{{ product.compare_at_price|price }}</span>
                                    {% endif %}
                                </div>

                                {% if product.stock_quantity > 0 %}
                                    <button type="button" class="btn-quick-add" data-id="{{ product.id }}" title="افزودن سریع به سبد خرید" aria-label="افزودن به سبد">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                                        </svg>
                                        <span class="add-txt">خرید</span>
                                    </button>
                                {% else %}
                                    <span class="btn-quick-disabled">ناموجود</span>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <!-- Navigation Button Left (Next in RTL) -->
            <button type="button" class="carousel-nav-btn carousel-next" id="carouselNextBtn" aria-label="محصولات بعدی" title="بعدی">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
        </div>
    </section>

    {# ================================================================= #}
    {# 5. PASTEL PROMO BANNER STRIP (Highlighter & Marker World)         #}
    {# ================================================================= #}
    <section class="promo-strip-card" data-tilt data-tilt-max="8" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1" data-aos="zoom-in">
        <div class="strip-content">
            <span class="strip-badge">🖍️ دنیای هایلایترهای پاستلی</span>
            <h3>رنگ‌های ملایم، بدون پس دادن جوهر روی کاغذ</h3>
            <p>مجموعه ماژیک‌های پاستلی استبیلو، پنتر و اشنایدر برای زیباتر کردن خلاصه‌نویسی‌ها و درس خواندن لذت‌بخش</p>
        </div>
        <a href="{{ url('products') }}" class="btn-strip-cta">کشف هایلایترها ✨</a>
    </section>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const sliderContainer = document.querySelector(".hero-banner-slider");
    if (!sliderContainer) return;

    // 1. Initialize 3D Tilt Effect on Wide Banner Slider
    if (typeof VanillaTilt !== 'undefined') {
        VanillaTilt.init(sliderContainer, {
            max: 8,
            speed: 600,
            perspective: 1200,
            scale: 1.01,
            glare: true,
            "max-glare": 0.15
        });
    }

    // 2. Slider Carousel Controls (Autoplay 5s, Arrows, Dots, Drag & Swipe)
    const slides = sliderContainer.querySelectorAll('.hero-banner-slide');
    const dots = sliderContainer.querySelectorAll('.hero-slider-dot');
    const prevBtn = document.getElementById('heroSliderPrev');
    const nextBtn = document.getElementById('heroSliderNext');

    if (!slides.length) return;

    let currentIndex = 0;
    let autoTimer = null;
    const total = slides.length;

    function goToSlide(index) {
        if (index < 0) {
            index = total - 1;
        } else if (index >= total) {
            index = 0;
        }
        currentIndex = index;

        slides.forEach(function(s, idx) {
            s.classList.toggle('active', idx === currentIndex);
        });

        dots.forEach(function(d, idx) {
            d.classList.toggle('active', idx === currentIndex);
        });
    }

    function nextSlide() {
        goToSlide(currentIndex + 1);
    }

    function prevSlide() {
        goToSlide(currentIndex - 1);
    }

    function startAutoPlay() {
        if (total <= 1) return;
        stopAutoPlay();
        autoTimer = setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
        if (autoTimer) {
            clearInterval(autoTimer);
            autoTimer = null;
        }
    }

    if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            prevSlide();
            startAutoPlay();
        });
    }

    if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            nextSlide();
            startAutoPlay();
        });
    }

    dots.forEach(function(dot, idx) {
        dot.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(idx);
            startAutoPlay();
        });
    });

    sliderContainer.addEventListener('mouseenter', stopAutoPlay);
    sliderContainer.addEventListener('mouseleave', startAutoPlay);

    // Mouse Dragging Support
    let isMouseDown = false;
    let mouseStartX = 0;
    let mouseMoved = false;

    sliderContainer.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        isMouseDown = true;
        mouseStartX = e.clientX;
        mouseMoved = false;
        stopAutoPlay();
    });

    window.addEventListener('mousemove', function(e) {
        if (!isMouseDown) return;
        if (Math.abs(e.clientX - mouseStartX) > 8) {
            mouseMoved = true;
        }
    });

    window.addEventListener('mouseup', function(e) {
        if (!isMouseDown) return;
        isMouseDown = false;
        const diff = e.clientX - mouseStartX;
        if (mouseMoved && Math.abs(diff) > 40) {
            if (diff > 0) {
                prevSlide(); // RTL previous
            } else {
                nextSlide(); // RTL next
            }
        }
        startAutoPlay();
    });

    // Prevent link click when dragged
    sliderContainer.addEventListener('click', function(e) {
        if (mouseMoved) {
            e.preventDefault();
            e.stopPropagation();
            mouseMoved = false;
        }
    }, true);

    // Touch Swipe Support for Mobile
    let touchStartX = 0;
    let touchDiff = 0;

    sliderContainer.addEventListener('touchstart', function(e) {
        if (e.touches && e.touches[0]) {
            touchStartX = e.touches[0].clientX;
        }
        touchDiff = 0;
        stopAutoPlay();
    }, { passive: true });

    sliderContainer.addEventListener('touchmove', function(e) {
        if (e.touches && e.touches[0]) {
            touchDiff = e.touches[0].clientX - touchStartX;
        }
    }, { passive: true });

    sliderContainer.addEventListener('touchend', function() {
        if (Math.abs(touchDiff) > 40) {
            if (touchDiff > 0) {
                prevSlide();
            } else {
                nextSlide();
            }
        }
        touchDiff = 0;
        startAutoPlay();
    });

    startAutoPlay();
});
</script>
{% endblock %}
