{% extends 'layouts/base.twig' %}

{% block content %}
<div class="container">
    {# ================================================================= #}
    {# 1. DYNAMIC HERO CAROUSEL WITH 3D TILT EFFECT                     #}
    {# ================================================================= #}
    <section class="hero-carousel-container" data-aos="fade-up" id="heroCarouselContainer">
        {# Playful Floating Decorative Stickers #}
        <div class="deco-floating-sticker theme-pink float-soft" style="top: 20px; left: 40px;">
            <span>✏️</span>
            <span>تراش و پاک‌کن فانتزی</span>
        </div>
        <div class="deco-floating-sticker theme-lavender float-reverse float-delay-1" style="bottom: 24px; left: 80px;">
            <span>📎</span>
            <span>گیره کاغذ پاستلی</span>
        </div>

        {# Slides Track #}
        <div class="hero-carousel-slides" id="heroSliderSlides">
            {% if sliders is defined and sliders|length > 0 %}
                {% for slider in sliders %}
                    <div class="hero-carousel-slide {% if loop.first %}active{% endif %}" data-slide-index="{{ loop.index0 }}">
                        <div class="hero-grid">
                            {# Right Column: Catchy Copy, Badges & Float CTA #}
                            <div class="hero-text-col" data-aos="fade-left" data-aos-delay="100">
                                <div class="hero-pill-badge">
                                    <span class="badge-sparkle">✨</span>
                                    <span>کالکشن جدید و فانتزی نوشت‌افزار ۱۴۰۵</span>
                                </div>

                                <h1 class="hero-main-title">
                                    {{ slider.title }}
                                </h1>

                                {% if slider.subtitle %}
                                    <p class="hero-subtitle">
                                        {{ slider.subtitle }}
                                    </p>
                                {% endif %}

                                <div class="hero-cta-group">
                                    <a href="{{ url(slider.link) }}" class="btn-hero-primary">
                                        <span>مشاهده و خرید</span>
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                                        </svg>
                                    </a>
                                    <a href="{{ url('products') }}" class="btn-hero-secondary">
                                        <span>کاتالوگ کل محصولات ✏️</span>
                                    </a>
                                </div>

                                <div class="hero-trust-badges">
                                    <div class="trust-badge-item">
                                        <span class="trust-icon">🚀</span>
                                        <div>
                                            <strong>ارسال سریع سراسری</strong>
                                            <small>پست پیشتاز و تیپاکس</small>
                                        </div>
                                    </div>
                                    <div class="trust-badge-item">
                                        <span class="trust-icon">💎</span>
                                        <div>
                                            <strong>ضمانت ۱۰۰٪ اصالت</strong>
                                            <small>اورجینال برندهای برتر</small>
                                        </div>
                                    </div>
                                    <div class="trust-badge-item">
                                        <span class="trust-icon">🎁</span>
                                        <div>
                                            <strong>بسته‌بندی ایمن و کادویی</strong>
                                            <small>هدیه درون هر بسته</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# Left Column: Visual Showcase Box with 3D Tilt Effect #}
                            <div class="hero-visual-col" data-aos="zoom-in" data-aos-delay="200">
                                <div class="hero-glass-showcase hero-tilt-card" data-tilt data-tilt-max="15" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.2">
                                    <div class="floating-sticker sticker-top">
                                        <span>📓</span>
                                        <span>پلنر و ژورنال فانتزی</span>
                                    </div>

                                    <div class="showcase-center-art">
                                        <img src="{{ asset(slider.image_url) }}" alt="{{ slider.title }}" class="hero-composite-img" loading="eager" width="540" height="480">
                                    </div>

                                    <div class="showcase-rating-card">
                                        <div class="stars-row">⭐⭐⭐⭐⭐</div>
                                        <strong>۴.۹ از ۵ رضایت خریداران</strong>
                                        <span>بیش از ۲،۴۰۰ نظر تاییدشده تحریرچی</span>
                                    </div>

                                    <div class="floating-sticker sticker-bottom">
                                        <span>🌸</span>
                                        <span>بسته‌بندی ویژه و دوست‌داشتنی</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                {# Fallback Static Hero if no sliders defined #}
                <div class="hero-carousel-slide active" data-slide-index="0">
                    <div class="hero-grid">
                        <div class="hero-text-col">
                            <div class="hero-pill-badge">
                                <span class="badge-sparkle">✨</span>
                                <span>کالکشن جدید و فانتزی نوشت‌افزار ۱۴۰۵</span>
                            </div>
                            <h1 class="hero-main-title">
                                دنیای رنگارنگ، کیوت و دوست‌داشتنیِ <span class="gradient-text">لوازم‌التحریر</span>
                            </h1>
                            <p class="hero-subtitle">
                                خاص‌ترین روان‌نویس‌های ژاپنی و آلمانی، اتودهای مهندسی روترینگ، پلنرهای انگیزشی و ماژیک‌های هایلایتر پاستلی با ضمانت ۱۰۰٪ اصالت فیزیکی! 🎀
                            </p>
                            <div class="hero-cta-group">
                                <a href="{{ url('products') }}" class="btn-hero-primary">
                                    <span>مشاهده کاتالوگ محصولات</span>
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                                    </svg>
                                </a>
                                <a href="{{ url('products?category=writing-instruments') }}" class="btn-hero-secondary">
                                    <span>قلم و روان‌نویس‌ها ✏️</span>
                                </a>
                            </div>
                        </div>
                        <div class="hero-visual-col">
                            <div class="hero-glass-showcase hero-tilt-card" data-tilt data-tilt-max="15" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.2">
                                <div class="showcase-center-art">
                                    <img src="{{ asset('images/banners/hero-showcase.webp') }}" alt="چیدمان فانتزی لوازم‌التحریر" class="hero-composite-img" width="540" height="480">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {% if sliders is defined and sliders|length > 1 %}
            <!-- Navigation Arrows (Previous is Right, Next is Left in RTL) -->
            <button type="button" class="hero-nav-arrow hero-prev-btn" id="heroPrevBtn" aria-label="اسلاید قبلی" title="قبلی">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
            </button>
            <button type="button" class="hero-nav-arrow hero-next-btn" id="heroNextBtn" aria-label="اسلاید بعدی" title="بعدی">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </button>

            <!-- Navigation Dots -->
            <div class="hero-carousel-dots" id="heroDotsWrap">
                {% for slider in sliders %}
                    <button type="button" class="hero-dot-btn {% if loop.first %}active{% endif %}" data-index="{{ loop.index0 }}" aria-label="رفتن به اسلاید {{ loop.index|fa_num }}"></button>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {# ================================================================= #}
    {# 2. CIRCULAR STORY CATEGORIES (Pastel Story Bubbles)               #}
    {# ================================================================= #}
    <section class="story-categories-section" data-aos="fade-up">
        <div class="story-categories-header">
            <div>
                <h2 class="story-section-title">💖 دسته‌بندی‌های محبوب و رنگی‌رنگی</h2>
                <p class="story-section-hint">روی دسته‌بندی مورد علاقه خود بزنید تا فانتزی‌ترین‌ها را ببینید</p>
            </div>
            <a href="{{ url('products') }}" class="story-view-all">مشاهده همه ←</a>
        </div>

        <div class="story-categories-track">
            <a href="{{ url('products?category=writing-instruments') }}" class="story-cat-item" data-aos="zoom-in" data-aos-delay="50">
                <div class="story-circle">
                    <div class="story-inner-badge badge-pink">
                        <span class="story-emoji">✏️</span>
                    </div>
                </div>
                <span class="story-label">نوشت‌افزار و قلم</span>
            </a>

            <a href="{{ url('products?category=notebooks-and-paper') }}" class="story-cat-item" data-aos="zoom-in" data-aos-delay="100">
                <div class="story-circle">
                    <div class="story-inner-badge badge-lavender">
                        <span class="story-emoji">📓</span>
                    </div>
                </div>
                <span class="story-label">دفتر و پلنر انگیزشی</span>
            </a>

            <a href="{{ url('products?category=art-and-drawing') }}" class="story-cat-item" data-aos="zoom-in" data-aos-delay="150">
                <div class="story-circle">
                    <div class="story-inner-badge badge-mint">
                        <span class="story-emoji">🎨</span>
                    </div>
                </div>
                <span class="story-label">نقاشی و مدادرنگی</span>
            </a>

            <a href="{{ url('products?category=office-supplies') }}" class="story-cat-item" data-aos="zoom-in" data-aos-delay="200">
                <div class="story-circle">
                    <div class="story-inner-badge badge-butter">
                        <span class="story-emoji">📎</span>
                    </div>
                </div>
                <span class="story-label">لوازم اداری و میز</span>
            </a>

            <a href="{{ url('products?category=mechanical-pencils') }}" class="story-cat-item" data-aos="zoom-in" data-aos-delay="250">
                <div class="story-circle">
                    <div class="story-inner-badge badge-sky">
                        <span class="story-emoji">📐</span>
                    </div>
                </div>
                <span class="story-label">اتود و خط‌کش مهندسی</span>
            </a>

            <a href="{{ url('products?category=rollerball-pens') }}" class="story-cat-item" data-aos="zoom-in" data-aos-delay="300">
                <div class="story-circle">
                    <div class="story-inner-badge badge-peach">
                        <span class="story-emoji">🖊️</span>
                    </div>
                </div>
                <span class="story-label">روان‌نویس و خودنویس</span>
            </a>
        </div>
    </section>

    {# ================================================================= #}
    {# 3. PROMO TILES (Commercial Composite Images & Clean Cards)        #}
    {# ================================================================= #}
    <section class="promo-tiles-section" data-aos="fade-up">
        <div class="promo-grid">
            <div class="promo-tile promo-tile-peach" data-tilt data-tilt-max="12" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.15" data-aos="zoom-in" data-aos-delay="100">
                <div class="promo-content">
                    <span class="promo-badge">🎀 کالکشن کیوت بولت ژورنال</span>
                    <h3 class="promo-title">پک‌های هدیه و دفترهای نقطه‌ای</h3>
                    <p class="promo-desc">شامل دفترهای جلدسخت، استیکرهای ژورنال و چسب‌های واشی با تخفیف هیجان‌انگیز</p>
                    <a href="{{ url('products?category=notebooks-and-paper') }}" class="promo-btn">مشاهده کالکشن ژورنال ←</a>
                </div>
                <div class="promo-art-box">
                    <img src="{{ asset('images/banners/promo-journal.webp') }}" alt="کالکشن بولت ژورنال و دفترهای فانتزی" class="promo-composite-img" loading="lazy" width="360" height="320">
                </div>
            </div>

            <div class="promo-tile promo-tile-lavender" data-tilt data-tilt-max="12" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.15" data-aos="zoom-in" data-aos-delay="200">
                <div class="promo-content">
                    <span class="promo-badge">📐 نوشت‌افزار تکنیکال و دقیق</span>
                    <h3 class="promo-title">روترینگ و فابرکاستل آلمان</h3>
                    <p class="promo-desc">ضمانت اصالت فیزیکی تمامی اتودها، نوک‌ها و مدادرنگی‌های تخصصی با بسته‌بندی هاردباکس</p>
                    <a href="{{ url('products?category=writing-instruments') }}" class="promo-btn">خرید محصولات مهندسی ←</a>
                </div>
                <div class="promo-art-box">
                    <img src="{{ asset('images/banners/promo-technical.webp') }}" alt="ابزارهای تخصصی طراحی و مهندسی روترینگ" class="promo-composite-img" loading="lazy" width="360" height="320">
                </div>
            </div>
        </div>
    </section>

    {# ================================================================= #}
    {# ================================================================= #}
    {# 4. INTERACTIVE PRODUCT CAROUSEL (Commercial Rich Cards)           #}
    {# ================================================================= #}
    <section class="featured-section" data-aos="fade-up">
        <div class="section-header">
            <div>
                <h2 class="section-title">✨ محصولات منتخب و شگفت‌انگیز تحریرچی</h2>
                <p class="section-subtitle">پرفروش‌ترین‌های این هفته با تخفیف ویژه و بسته‌بندی اختصاصی</p>
            </div>
            <a href="{{ url('products') }}" class="view-all-link">
                <span>مشاهده کاتالوگ کامل</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </a>
        </div>

        <!-- Horizontal Product Carousel -->
        <div class="product-carousel-wrapper">
            <!-- Navigation Button Right (Prev in RTL) -->
            <button type="button" class="carousel-nav-btn carousel-prev" id="carouselPrevBtn" aria-label="محصولات قبلی" title="قبلی">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
            </button>

            <!-- Carousel Track with Swipe / Drag & Snap -->
            <div class="product-carousel-track" id="featuredCarouselTrack">
                {% for product in featured_products %}
                    <article class="product-card carousel-slide {% if product.stock_quantity <= 0 %}out-of-stock{% endif %}">
                        <div class="product-thumb">
                            <a href="{{ url('products/' ~ product.slug) }}" class="thumb-link">
                                <img src="{{ product.primary_image ? asset(product.primary_image) : asset('images/placeholder.webp') }}" alt="{{ product.title }}" loading="lazy">
                            </a>

                            <!-- Wishlist Heart Button -->
                            <button type="button" class="btn-wishlist" data-id="{{ product.id }}" title="افزودن به علاقه‌مندی‌ها" aria-label="علاقه‌مندی">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                                </svg>
                            </button>

                            <div class="product-badges-wrap">
                                {% if product.compare_at_price and product.compare_at_price > product.price %}
                                    {% set discount = ((product.compare_at_price - product.price) / product.compare_at_price * 100)|round %}
                                    <span class="badge-discount">🔥 {{ discount|fa_num }}% تخفیف</span>
                                {% elseif product.is_featured %}
                                    <span class="badge-featured">⭐ محبوب</span>
                                {% endif %}

                                {% if product.stock_quantity <= 0 %}
                                    <span class="badge-out-of-stock">ناموجود</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="product-info-wrap">
                            <span class="product-category-brand">{{ product.brand ?? 'تحریرچی' }} · {{ product.category_title }}</span>

                            <!-- 5-Star Commercial Rating Row -->
                            <div class="product-rating-row">
                                <div class="rating-stars" aria-label="امتیاز ۵ از ۵">
                                    <span class="star-gold">★</span>
                                    <span class="star-gold">★</span>
                                    <span class="star-gold">★</span>
                                    <span class="star-gold">★</span>
                                    <span class="star-gold">★</span>
                                </div>
                                <span class="rating-val">{{ (4.7 + ((product.id * 3) % 4) * 0.1)|number_format(1, '.')|fa_num }}</span>
                                <span class="rating-count">({{ (15 + (product.id * 17) % 65)|fa_num }})</span>
                            </div>

                            <h3 class="product-title">
                                <a href="{{ url('products/' ~ product.slug) }}" title="{{ product.title }}">{{ product.title }}</a>
                            </h3>

                            {# Low Stock Urgency Indicator (<= 5 items) #}
                            {% if product.stock_quantity > 0 and product.stock_quantity <= 5 %}
                                <div class="product-stock-urgency">
                                    <span class="urgency-dot"></span>
                                    <span>تنها {{ product.stock_quantity|fa_num }} عدد در انبار باقی مانده!</span>
                                </div>
                            {% endif %}

                            {# Color Swatch Dots for products with variants #}
                            {% if product.variants is defined and product.variants|length > 0 %}
                                <div class="product-color-dots" title="تنوع رنگی موجود">
                                    {% set shownColors = [] %}
                                    {% for v in product.variants %}
                                        {% if v.color_hex and v.color_hex not in shownColors %}
                                            {% set shownColors = shownColors|merge([v.color_hex]) %}
                                            <span class="color-swatch-dot" style="background-color: {{ v.color_hex }};" title="{{ v.attribute_value }}"></span>
                                        {% endif %}
                                    {% endfor %}
                                    <span class="color-count-label">{{ product.variants|length|fa_num }} تنوع</span>
                                </div>
                            {% else %}
                                <div class="product-color-placeholder"></div>
                            {% endif %}

                            <div class="product-pricing">
                                <div class="price-box">
                                    <span class="price-current">{{ product.price|price }}</span>
                                    {% if product.compare_at_price and product.compare_at_price > product.price %}
                                        <span class="price-old">{{ product.compare_at_price|price }}</span>
                                    {% endif %}
                                </div>

                                {% if product.stock_quantity > 0 %}
                                    <button type="button" class="btn-quick-add" data-id="{{ product.id }}" title="افزودن سریع به سبد خرید" aria-label="افزودن به سبد">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                                        </svg>
                                        <span class="add-txt">خرید</span>
                                    </button>
                                {% else %}
                                    <span class="btn-quick-disabled">ناموجود</span>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <!-- Navigation Button Left (Next in RTL) -->
            <button type="button" class="carousel-nav-btn carousel-next" id="carouselNextBtn" aria-label="محصولات بعدی" title="بعدی">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
        </div>
    </section>

    {# ================================================================= #}
    {# 5. PASTEL PROMO BANNER STRIP (Highlighter & Marker World)         #}
    {# ================================================================= #}
    <section class="promo-strip-card" data-tilt data-tilt-max="8" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1" data-aos="zoom-in">
        <div class="strip-content">
            <span class="strip-badge">🖍️ دنیای هایلایترهای پاستلی</span>
            <h3>رنگ‌های ملایم، بدون پس دادن جوهر روی کاغذ</h3>
            <p>مجموعه ماژیک‌های پاستلی استبیلو، پنتر و اشنایدر برای زیباتر کردن خلاصه‌نویسی‌ها و درس خواندن لذت‌بخش</p>
        </div>
        <a href="{{ url('products') }}" class="btn-strip-cta">کشف هایلایترها ✨</a>
    </section>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const slides = document.querySelectorAll('.hero-carousel-slide');
    const dots = document.querySelectorAll('.hero-dot-btn');
    const prevBtn = document.getElementById('heroPrevBtn');
    const nextBtn = document.getElementById('heroNextBtn');
    const container = document.getElementById('heroCarouselContainer');

    if (!slides.length) return;

    let currentIndex = 0;
    let autoTimer = null;
    const total = slides.length;

    function goToSlide(index) {
        if (index < 0) {
            index = total - 1;
        } else if (index >= total) {
            index = 0;
        }
        currentIndex = index;

        slides.forEach(function(s, idx) {
            if (idx === currentIndex) {
                s.classList.add('active');
            } else {
                s.classList.remove('active');
            }
        });

        dots.forEach(function(d, idx) {
            if (idx === currentIndex) {
                d.classList.add('active');
            } else {
                d.classList.remove('active');
            }
        });

        // Initialize 3D tilt on slide switch
        if (typeof VanillaTilt !== 'undefined') {
            const activeTilt = slides[currentIndex].querySelector('[data-tilt]');
            if (activeTilt && !activeTilt.vanillaTilt) {
                VanillaTilt.init(activeTilt, {
                    max: 15,
                    speed: 400,
                    glare: true,
                    "max-glare": 0.2,
                    perspective: 1000
                });
            }
        }
    }

    function startAutoSlide() {
        if (total <= 1) return;
        stopAutoSlide();
        autoTimer = setInterval(function() {
            goToSlide(currentIndex + 1);
        }, 5500);
    }

    function stopAutoSlide() {
        if (autoTimer) {
            clearInterval(autoTimer);
            autoTimer = null;
        }
    }

    if (prevBtn) {
        prevBtn.addEventListener('click', function() {
            goToSlide(currentIndex - 1);
            startAutoSlide();
        });
    }

    if (nextBtn) {
        nextBtn.addEventListener('click', function() {
            goToSlide(currentIndex + 1);
            startAutoSlide();
        });
    }

    dots.forEach(function(dot, idx) {
        dot.addEventListener('click', function() {
            goToSlide(idx);
            startAutoSlide();
        });
    });

    if (container) {
        container.addEventListener('mouseenter', stopAutoSlide);
        container.addEventListener('mouseleave', startAutoSlide);

        // Touch swipe support for mobile
        let startX = 0;
        let diffX = 0;

        container.addEventListener('touchstart', function(e) {
            if (e.touches && e.touches[0]) {
                startX = e.touches[0].clientX;
            }
            stopAutoSlide();
        }, { passive: true });

        container.addEventListener('touchmove', function(e) {
            if (e.touches && e.touches[0]) {
                diffX = e.touches[0].clientX - startX;
            }
        }, { passive: true });

        container.addEventListener('touchend', function() {
            if (Math.abs(diffX) > 40) {
                if (diffX > 0) {
                    goToSlide(currentIndex - 1);
                } else {
                    goToSlide(currentIndex + 1);
                }
            }
            diffX = 0;
            startAutoSlide();
        });
    }

    startAutoSlide();
});
</script>
{% endblock %}
