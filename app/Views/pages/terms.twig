{% extends 'layouts/base.twig' %}

{% block content %}
<div class="container">
    <!-- Breadcrumb & Header -->
    <div class="page-header-simple">
        <nav class="breadcrumb-nav" aria-label="مسیر راهنما">
            <a href="{{ url('/') }}">صفحه اصلی</a>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-current">قوانین و مقررات</span>
        </nav>
        <h1 class="page-title-main">قوانین، رویه‌های بازگشت کالا و حریم خصوصی</h1>
        <p class="page-subtitle-main">شفافیت و قانون‌مداری، ضامن حفظ حقوق متقابل خریداران گرامی و فروشگاه تحریرچی است.</p>
    </div>

    <!-- Terms Content Wrapper -->
    <div class="terms-page-card">
        <div class="terms-meta-notice">
            <span>📅 آخرین به‌روزرسانی قوانین: آبان‌ماه ۱۴۰۵</span>
            <span>⚖️ منطبق با قانون تجارت الکترونیک جمهوری اسلامی ایران</span>
        </div>

        <article class="terms-article">
            <!-- Section 1: شرایط و قوانین عمومی -->
            <section class="terms-section-item" id="rules">
                <h2 id="rules-heading">۱. شرایط و ضوابط عمومی استفاده از تحریرچی</h2>
                <p>
                    ورود کاربران به وب‌سایت «تحریرچی» و ثبت سفارش در هر زمان به معنی پذیرفتن کامل کلیه شرایط و قوانین مندرج در این صفحه از سوی کاربر است. لازم به ذکر است شرایط و قوانین مندرج، جایگزین کلیه توافق‌های قبلی محسوب می‌شود.
                </p>
                <p>
                    ثبت هرگونه سفارش در تحریرچی مبتنی بر قوانین جاری کشور، قانون تجارت الکترونیک و قانون حمایت از حقوق مصرف‌کننده است و کاربر نیز موظف به رعایت قوانین مرتبط با کاربر است.
                </p>
            </section>

            <!-- Section 2: رویه ضمانت بازگشت ۷ روزه -->
            <section class="terms-section-item" id="returns">
                <h2 id="returns-heading">۲. رویه‌ها و شرایط ضمانت بازگشت ۷ روزه کالا</h2>
                <p>
                    تحریرچی در راستای تکریم مشتریان و اطمینان خاطر از خرید آنلاین، امکان بازگرداندن کالا تا ۷ روز پس از تحویل مرسوله را با شرایط زیر فراهم کرده است:
                </p>
                <ul class="terms-bullet-list">
                    <li>
                        <strong>عدم انطباق یا مغایرت کالا:</strong> در صورتی که کالای دریافت شده با مشخصات ثبت شده در سایت (مدل، سایز نوک، برند، رنگ) مغایرت داشته باشد، خریدار باید حداکثر ظرف ۴۸ ساعت پس از دریافت مرسوله موضوع را به پشتیبانی اطلاع دهد. کلیه هزینه‌های بازگشت بر عهده تحریرچی خواهد بود.
                    </li>
                    <li>
                        <strong>انصراف از خرید:</strong> در صورت انصراف خریدار از خرید، کالا تنها در صورتی قابل بازگشت است که پلمپ بسته‌بندی باز نشده، هیچ‌گونه خط، خش یا اثر استفاده روی کالا ایجاد نشده و در بسته‌بندی اولیه خود همراه با فاکتور عودت داده شود. در این حالت هزینه ارسال بازگشت بر عهده خریدار است.
                    </li>
                    <li>
                        <strong>نقص فنی و آسیب فیزیکی اولیه:</strong> در صورت بروز آسیب در زمان حمل، خریدار موظف است بسته را در حضور مامور پست بررسی و در صورت آسیب کارتن، صورت‌جلسه پستی دریافت نماید.
                    </li>
                </ul>
            </section>

            <!-- Section 3 -->
            <section class="terms-section-item">
                <h2>۳. فرآیند عودت وجه</h2>
                <p>
                    پس از دریافت کالای مرجوعی توسط انبار تحریرچی و تأیید کارشناسان فنی، وجه پرداختی خریدار ظرف مدت ۲۴ ساعت کاری از طریق شماره شبای اعلام‌شده از سوی مشتری به حساب بانکی ایشان واریز می‌گردد.
                </p>
            </section>

            <!-- Section 4: سیاست حفظ حریم خصوصی -->
            <section class="terms-section-item" id="privacy">
                <h2 id="privacy-heading">۴. سیاست حفظ حریم خصوصی کاربران (Privacy Policy)</h2>
                <p>
                    تحریرچی به حریم خصوصی اشخاصی که از خدمات سایت استفاده می‌کنند احترام گذاشته و از اطلاعات خصوصی کاربران محافظت می‌کند:
                </p>
                <ul class="terms-bullet-list">
                    <li>اطلاعات وارد شده در زمان ثبت‌نام و ثبت سفارش (شامل نام، شماره تماس، آدرس پستی و ایمیل) منحصراً جهت پردازش فاکتور، ارسال سفارش و ارائه خدمات پشتیبانی مورد استفاده قرار می‌گیرد.</li>
                    <li>تحریرچی متعهد می‌شود به هیچ عنوان اطلاعات کاربران را در اختیار شرکت‌ها یا اشخاص ثالث به مقاصد تبلیغاتی قرار ندهد.</li>
                    <li>کلیه تراکنش‌های مالی در بستر امن پروتکل شاپرک و درگاه‌های دارای گواهینامه SSL انجام می‌پذیرد و هیچ‌گونه اطلاعات مربوط به شماره کارت یا رمز عبور بانکی در سرورهای تحریرچی ذخیره نمی‌شود.</li>
                </ul>
            </section>

            <!-- Section 5 -->
            <section class="terms-section-item">
                <h2>۵. مالکیت فکری و معنوی</h2>
                <p>
                    تمامی محتواهای تولیدشده در وب‌سایت تحریرچی شامل متن‌ها، تصاویر اختصاصی محصولات، گرافیک‌ها، لوگو و کدهای سامانه متعلق به فروشگاه تحریرچی بوده و هرگونه استفاده تجاری یا کپی‌برداری بدون ذکر منبع و مجوز کتبی، پیگرد قانونی به همراه دارد.
                </p>
            </section>
        </article>

        <!-- Help box at bottom -->
        <div class="terms-footer-notice">
            <p>پرسشی درباره قوانین دارید؟ تیم حقوقی و پشتیبانی ما آماده پاسخگویی به شماست.</p>
            <a href="{{ url('contact-us') }}" class="terms-contact-link">ارتباط با پشتیبانی تحریرچی ←</a>
        </div>
    </div>
</div>
{% endblock %}
