{% extends 'layouts/base.twig' %}

{% block content %}
<div class="container">
    <!-- Breadcrumb & Header -->
    <div class="page-header-simple">
        <nav class="breadcrumb-nav" aria-label="مسیر راهنما">
            <a href="{{ url('/') }}">صفحه اصلی</a>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-current">تماس با ما</span>
        </nav>
        <h1 class="page-title-main">همواره آماده شنیدن صدای شما هستیم</h1>
        <p class="page-subtitle-main">سوالی درباره مشخصات فنی محصولات دارید یا به پیگیری سفارش نیاز دارید؟ با ما در ارتباط باشید.</p>
    </div>

    <!-- Contact Two-Column Grid Layout -->
    <div class="contact-layout-grid">
        <!-- Right Column: Contact Details Card -->
        <aside class="contact-info-card">
            <div class="contact-card-header">
                <span class="info-badge">📞 پشتیبانی پاسخگو</span>
                <h2>اطلاعات تماس و دفتر مرکزی</h2>
                <p>تیم پشتیبانی تحریرچی همه روزه آماده پاسخگویی به پرسش‌ها و ارائه مشاوره تخصصی خرید است.</p>
            </div>

            <div class="contact-info-list">
                <div class="contact-info-item">
                    <div class="info-icon-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                    </div>
                    <div>
                        <h4>تلفن تماس و مشاوره فنی</h4>
                        <p class="info-val dir-ltr"><a href="tel:02188884321">۰۲۱-۸۸۸۸۴۳۲۱</a></p>
                        <small>شنبه تا چهارشنبه ۹ الی ۱۸ | پنج‌شنبه‌ها ۹ الی ۱۴</small>
                    </div>
                </div>

                <div class="contact-info-item">
                    <div class="info-icon-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div>
                        <h4>پست الکترونیکی</h4>
                        <p class="info-val dir-ltr"><a href="mailto:support@tahrirchi.com">support@tahrirchi.com</a></p>
                        <small>پاسخگویی سریع ظرف حداکثر ۲ ساعت کاری</small>
                    </div>
                </div>

                <div class="contact-info-item">
                    <div class="info-icon-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <div>
                        <h4>نشانی دفتر مرکزی تحریرچی</h4>
                        <p class="info-val">تهران، خیابان انقلاب اسلامی، بین ابوریحان و فلسطین، ساختمان تحریر، طبقه ۳، واحد ۶</p>
                        <small>کد پستی: ۱۳۱۴۹۶۳۸۷۱ (مراجعات حضوری فقط با هماهنگی قبلی)</small>
                    </div>
                </div>
            </div>

            <!-- Trust Badges & Guarantee Strip inside Card -->
            <div class="contact-trust-pill">
                <span class="trust-pill-emoji">🛡️</span>
                <div>
                    <strong>دارای نماد اعتماد الکترونیکی (اینماد)</strong>
                    <p>ثبت شده در سامانه تجارت الکترونیک و درگاه‌های پرداخت شاپرک</p>
                </div>
            </div>
        </aside>

        <!-- Left Column: AJAX Contact Form -->
        <main class="contact-form-card">
            <div class="form-card-header">
                <h2>ارسال مستقیم پیام به کارشناسان</h2>
                <p>فرم زیر را تکمیل فرمایید؛ پیام شما بلافاصله در سیستم تیکتینگ تحریرچی ثبت خواهد شد.</p>
            </div>

            <form id="contactForm" action="{{ url('contact-us') }}" method="POST" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">

                <div class="form-row-2">
                    <div class="form-group">
                        <label for="contactName">نام و نام‌خانوادگی <span class="required">*</span></label>
                        <input type="text" id="contactName" name="name" class="form-input" placeholder="مثال: آرمان اسدی" required>
                        <div class="field-error" id="err_name"></div>
                    </div>

                    <div class="form-group">
                        <label for="contactEmail">آدرس ایمیل معتبر <span class="required">*</span></label>
                        <input type="email" id="contactEmail" name="email" class="form-input dir-ltr" placeholder="name@example.com" required>
                        <div class="field-error" id="err_email"></div>
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label for="contactPhone">شماره تماس (اختیاری)</label>
                        <input type="tel" id="contactPhone" name="phone" class="form-input dir-ltr" placeholder="۰۹۱۲۳۴۵۶۷۸۹">
                        <div class="field-error" id="err_phone"></div>
                    </div>

                    <div class="form-group">
                        <label for="contactSubject">موضوع پیام <span class="required">*</span></label>
                        <input type="text" id="contactSubject" name="subject" class="form-input" placeholder="مثال: پیگیری سفارش / مشاوره خرید اتود" required>
                        <div class="field-error" id="err_subject"></div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="contactMessage">متن پیام یا پرسش شما <span class="required">*</span></label>
                    <textarea id="contactMessage" name="message" class="form-textarea" rows="5" placeholder="جزئیات درخواست یا سوال خود را اینجا یادداشت فرمایید..." required></textarea>
                    <div class="field-error" id="err_message"></div>
                </div>

                <div class="form-actions-row">
                    <button type="submit" id="contactSubmitBtn" class="btn-submit-contact">
                        <span class="btn-text">ارسال پیام به پشتیبانی</span>
                        <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                        </svg>
                    </button>
                    <span id="contactFormStatus" class="form-status-msg" aria-live="polite"></span>
                </div>
            </form>
        </main>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactForm');
    const submitBtn = document.getElementById('contactSubmitBtn');
    const statusMsg = document.getElementById('contactFormStatus');

    if (!form || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Clear previous error states
        document.querySelectorAll('.field-error').forEach(el => el.textContent = '');
        document.querySelectorAll('.form-input, .form-textarea').forEach(el => el.classList.remove('has-error'));
        statusMsg.textContent = '';
        statusMsg.className = 'form-status-msg';

        // Form data preparation
        const formData = new FormData(form);
        const submitUrl = form.getAttribute('action');

        // Loading state
        submitBtn.disabled = true;
        const originalText = submitBtn.querySelector('.btn-text').textContent;
        submitBtn.querySelector('.btn-text').textContent = 'در حال ارسال پیام...';

        try {
            const res = await fetch(submitUrl, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            });

            const data = await res.json();

            if (res.ok && data.success) {
                // Success feedback
                form.reset();
                if (typeof showToast === 'function') {
                    showToast(data.message || 'پیام شما با موفقیت ثبت شد.', 'success');
                }
                statusMsg.textContent = data.message || 'پیام شما با موفقیت ثبت شد.';
                statusMsg.classList.add('text-success');
            } else {
                // Validation or server error
                const msg = data.message || 'خطا در ثبت پیام. لطفاً اطلاعات را بررسی فرمایید.';
                if (typeof showToast === 'function') {
                    showToast(msg, 'error');
                }
                statusMsg.textContent = msg;
                statusMsg.classList.add('text-danger');

                if (data.errors && typeof data.errors === 'object') {
                    for (const [field, text] of Object.entries(data.errors)) {
                        const errEl = document.getElementById('err_' + field);
                        const inputEl = document.getElementById('contact' + field.charAt(0).toUpperCase() + field.slice(1));
                        if (errEl) errEl.textContent = text;
                        if (inputEl) inputEl.classList.add('has-error');
                    }
                }
            }
        } catch (err) {
            const errorMsg = 'خطای اتصال به سرور. لطفاً اتصال اینترنت خود را بررسی نمایید.';
            if (typeof showToast === 'function') {
                showToast(errorMsg, 'error');
            }
            statusMsg.textContent = errorMsg;
            statusMsg.classList.add('text-danger');
        } finally {
            submitBtn.disabled = false;
            submitBtn.querySelector('.btn-text').textContent = originalText;
        }
    });
});
</script>
{% endblock %}
