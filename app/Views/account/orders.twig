{% extends 'account/layout.twig' %}

{% block account_content %}
<div class="account-card-panel">
    <div class="panel-header-simple">
        <div>
            <h2>تاریخچه سفارش‌های من</h2>
            <p>لیست کلیه سفارش‌های ثبت‌شده به همراه فاکتور رسمی و وضعیت ارسال مرسوله پستی.</p>
        </div>
    </div>

    <!-- Filter Tabs Strip -->
    <div class="orders-filter-strip">
        <a href="{{ url('account/orders') }}" class="filter-tab-pill {% if current_filter == '' %}active{% endif %}" data-status="">
            همه سفارش‌ها
        </a>
        <a href="{{ url('account/orders?status=processing') }}" class="filter-tab-pill {% if current_filter == 'processing' %}active{% endif %}" data-status="processing">
            در حال پردازش
        </a>
        <a href="{{ url('account/orders?status=shipped') }}" class="filter-tab-pill {% if current_filter == 'shipped' %}active{% endif %}" data-status="shipped">
            ارسال شده با پست
        </a>
        <a href="{{ url('account/orders?status=delivered') }}" class="filter-tab-pill {% if current_filter == 'delivered' %}active{% endif %}" data-status="delivered">
            تحویل شده
        </a>
        <a href="{{ url('account/orders?status=cancelled') }}" class="filter-tab-pill {% if current_filter == 'cancelled' %}active{% endif %}" data-status="cancelled">
            لغو شده
        </a>
    </div>

    <!-- Dynamic AJAX Orders Container -->
    <div id="ordersContainer" class="orders-dynamic-container">
        {% include 'account/_orders_list.twig' %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterPills = document.querySelectorAll('.orders-filter-strip .filter-tab-pill');
    const container = document.getElementById('ordersContainer');
    if (!filterPills.length || !container) return;

    filterPills.forEach(pill => {
        pill.addEventListener('click', function(e) {
            e.preventDefault();
            const targetUrl = this.getAttribute('href');
            if (!targetUrl) return;

            // Immediately switch active class without page refresh
            filterPills.forEach(p => p.classList.remove('active'));
            this.classList.add('active');

            // Visual feedback
            container.style.opacity = '0.5';
            container.style.pointerEvents = 'none';

            fetch(targetUrl, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            })
            .then(res => {
                if (!res.ok) throw new Error('Network error');
                return res.json();
            })
            .then(data => {
                if (data && data.success && data.html !== undefined) {
                    container.innerHTML = data.html;
                    if (window.history && window.history.pushState) {
                        window.history.pushState({ path: targetUrl }, '', targetUrl);
                    }
                } else {
                    window.location.href = targetUrl;
                }
            })
            .catch(() => {
                window.location.href = targetUrl;
            })
            .finally(() => {
                container.style.opacity = '1';
                container.style.pointerEvents = 'auto';
            });
        });
    });

    window.addEventListener('popstate', function() {
        window.location.reload();
    });
});
</script>
{% endblock %}
