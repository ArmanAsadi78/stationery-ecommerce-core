{% extends is_pjax ? 'layouts/blank.twig' : 'account/layout.twig' %}

{% block account_content %}
<div class="account-card-panel">
    <div class="panel-header-simple">
        <div>
            <h2>تاریخچه سفارش‌های من</h2>
            <p>لیست کلیه سفارش‌های ثبت‌شده به همراه فاکتور رسمی و وضعیت ارسال مرسوله پستی.</p>
        </div>
    </div>

    <!-- Filter Tabs Strip -->
    <div class="orders-filter-strip">
        <a href="{{ url('account/orders') }}" class="filter-tab-pill {% if current_filter == '' %}active{% endif %}" data-status="">
            همه سفارش‌ها
        </a>
        <a href="{{ url('account/orders?status=processing') }}" class="filter-tab-pill {% if current_filter == 'processing' %}active{% endif %}" data-status="processing">
            در حال پردازش
        </a>
        <a href="{{ url('account/orders?status=shipped') }}" class="filter-tab-pill {% if current_filter == 'shipped' %}active{% endif %}" data-status="shipped">
            ارسال شده با پست
        </a>
        <a href="{{ url('account/orders?status=delivered') }}" class="filter-tab-pill {% if current_filter == 'delivered' %}active{% endif %}" data-status="delivered">
            تحویل شده
        </a>
        <a href="{{ url('account/orders?status=cancelled') }}" class="filter-tab-pill {% if current_filter == 'cancelled' %}active{% endif %}" data-status="cancelled">
            لغو شده
        </a>
    </div>

    <!-- Dynamic AJAX Orders Container -->
    <div id="ordersContainer" class="orders-dynamic-container">
        {% include 'account/_orders_list.twig' %}
    </div>
</div>
{% endblock %}
