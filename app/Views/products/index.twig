{% extends 'layouts/base.twig' %}

{% block content %}
<div class="container">
    <div style="margin: 24px 0 16px 0;">
        <h1 style="font-size: 24px; font-weight: 800;">
            {% if search_query %}
                نتایج جستجو برای: «{{ search_query }}»
            {% elseif current_category %}
                خرید آنلاین {{ current_category.title }}
            {% else %}
                کاتالوگ تمامی محصولات لوازم‌التحریر
            {% endif %}
        </h1>
        <p style="font-size: 14px; color: var(--text-muted); margin-top: 4px;">
            تعداد کل کالاهای یافت‌شده: <strong>{{ total|fa_num }}</strong> عدد
        </p>
    </div>

    <div class="catalog-layout">
        <!-- Filters Sidebar -->
        <aside class="catalog-sidebar">
            <h3 class="sidebar-title">
                <span>🎀 دسته‌بندی‌های نوشت‌افزار</span>
            </h3>
            <ul class="sidebar-cat-list">
                <li>
                    <a href="{{ url('products') }}" class="cat-link {% if not current_category %}active{% endif %}">
                        <span class="cat-icon">🌟</span>
                        <span>تمامی محصولات</span>
                    </a>
                </li>
                {% for cat in categories %}
                    <li>
                        <a href="{{ url('products?category=' ~ cat.slug) }}" class="cat-link {% if current_category and current_category.slug == cat.slug %}active{% endif %}">
                            <span class="cat-icon">
                                {% if 'writing' in cat.slug %}✏️{% elseif 'paper' in cat.slug %}📓{% elseif 'office' in cat.slug %}📎{% elseif 'art' in cat.slug %}🎨{% else %}📁{% endif %}
                            </span>
                            <span>{{ cat.title }}</span>
                        </a>
                        {% if cat.children|length > 0 %}
                            <ul class="subcat-list">
                                {% for sub in cat.children %}
                                    <li>
                                        <a href="{{ url('products?category=' ~ sub.slug) }}" class="subcat-link {% if current_category and current_category.slug == sub.slug %}active{% endif %}">
                                            <span>🌸 {{ sub.title }}</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </aside>

        <!-- Products Grid Area -->
        <div>
            {% if products|length == 0 %}
                <div style="background: var(--bg-card); padding: 60px 20px; text-align: center; border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
                    <p style="font-size: 18px; font-weight: 700; color: var(--text-main); margin-bottom: 8px;">هیچ محصولی با این مشخصات یافت نشد!</p>
                    <p style="font-size: 14px; color: var(--text-muted); margin-bottom: 20px;">می‌توانید فیلترها را حذف کرده و مجدداً تلاش فرمایید.</p>
                    <a href="{{ url('products') }}" style="display: inline-block; padding: 10px 24px; background: var(--primary); color: white; border-radius: var(--radius-md); font-weight: 600;">مشاهده همه کالاها</a>
                </div>
            {% else %}
                <div class="product-grid" style="margin-bottom: 32px;">
                    {% for product in products %}
                        <article class="product-card {% if product.stock_quantity <= 0 %}out-of-stock{% endif %}">
                            <div class="product-thumb">
                                <a href="{{ url('products/' ~ product.slug) }}">
                                    <img src="{{ product.primary_image ? asset(product.primary_image) : asset('images/placeholder.webp') }}" alt="{{ product.title }}" loading="lazy">
                                </a>

                                {% if product.compare_at_price and product.compare_at_price > product.price %}
                                    {% set discount = ((product.compare_at_price - product.price) / product.compare_at_price * 100)|round %}
                                    <span class="badge-discount">{{ discount|fa_num }}% تخفیف</span>
                                {% endif %}

                                {% if product.stock_quantity <= 0 %}
                                    <span class="badge-out-of-stock">ناموجود</span>
                                {% endif %}
                            </div>

                            <span class="product-brand">{{ product.brand }} | {{ product.category_title }}</span>
                            <h3 class="product-title">
                                <a href="{{ url('products/' ~ product.slug) }}">{{ product.title }}</a>
                            </h3>

                            <div class="product-pricing">
                                <div class="price-box">
                                    <span class="price-current">{{ product.price|price }}</span>
                                    {% if product.compare_at_price and product.compare_at_price > product.price %}
                                        <span class="price-old">{{ product.compare_at_price|price }}</span>
                                    {% endif %}
                                </div>

                                {% if product.stock_quantity > 0 %}
                                    <button type="button" class="btn-quick-add" data-id="{{ product.id }}" title="افزودن سریع به سبد خرید" aria-label="افزودن به سبد">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                                        </svg>
                                    </button>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>

                <!-- Pagination -->
                {% if total_pages > 1 %}
                    <div style="display: flex; justify-content: center; gap: 8px; margin: 30px 0;">
                        {% for p in 1..total_pages %}
                            <a href="{{ url('products?page=' ~ p ~ (current_category ? '&category=' ~ current_category.slug : '') ~ (search_query ? '&q=' ~ search_query : '')) }}" 
                               style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius-md); font-weight: 700; border: 1px solid var(--border-color); {% if p == current_page %}background: var(--primary); color: white; border-color: var(--primary);{% else %}background: white; color: var(--text-main);{% endif %}">
                                {{ p|fa_num }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
