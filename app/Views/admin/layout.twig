<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title|default('پنل مدیریت | تحریرچی') }}</title>
    
    <!-- Vazirmatn Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Admin Core Stylesheet -->
    <link rel="stylesheet" href="{{ asset('css/main.css') }}">
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <span class="brand-spark">⚡</span>
                <div class="brand-text">
                    <strong>تحریرچی</strong>
                    <small>پنل مدیریت و انبارداری</small>
                </div>
            </div>

            <nav class="admin-nav" aria-label="منوی ادمین">
                <span class="nav-section-title">مدیریت فروشگاه</span>
                <a href="{{ url('admin/dashboard') }}" class="admin-nav-item {% if active_menu == 'dashboard' %}active{% endif %}">
                    <span class="admin-nav-icon">📊</span>
                    <span>داشبورد و آمار کل</span>
                </a>
                <a href="{{ url('admin/orders') }}" class="admin-nav-item {% if active_menu == 'orders' %}active{% endif %}">
                    <span class="admin-nav-icon">📦</span>
                    <span>مدیریت سفارش‌ها</span>
                </a>
                <a href="{{ url('admin/products') }}" class="admin-nav-item {% if active_menu == 'products' %}active{% endif %}">
                    <span class="admin-nav-icon">🏷️</span>
                    <span>مدیریت محصولات</span>
                </a>
                <a href="{{ url('admin/categories') }}" class="admin-nav-item {% if active_menu == 'categories' %}active{% endif %}">
                    <span class="admin-nav-icon">📂</span>
                    <span>مدیریت دسته‌بندی‌ها</span>
                </a>
                <a href="{{ url('admin/menus') }}" class="admin-nav-item {% if active_menu == 'menus' %}active{% endif %}">
                    <span class="admin-nav-icon">🧭</span>
                    <span>مدیریت منوها</span>
                </a>
                <a href="{{ url('admin/sliders') }}" class="admin-nav-item {% if active_menu == 'sliders' %}active{% endif %}">
                    <span class="admin-nav-icon">🖼️</span>
                    <span>مدیریت اسلایدرها</span>
                </a>
                <a href="{{ url('admin/banners') }}" class="admin-nav-item {% if active_menu == 'banners' %}active{% endif %}">
                    <span class="admin-nav-icon">🎨</span>
                    <span>بنرهای تبلیغاتی میانی</span>
                </a>
                <a href="{{ url('admin/settings') }}" class="admin-nav-item {% if active_menu == 'settings' %}active{% endif %}">
                    <span class="admin-nav-icon">⚙️</span>
                    <span>تنظیمات عمومی سایت</span>
                </a>

                <span class="nav-section-title">دسترسی‌های سریع</span>
                <a href="{{ url('products') }}" target="_blank" class="admin-nav-item">
                    <span class="admin-nav-icon">🛍️</span>
                    <span>مشاهده سایت فروشگاه</span>
                </a>

                <form action="{{ url('admin/logout') }}" method="POST" class="admin-logout-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="admin-nav-item admin-nav-logout">
                        <span class="admin-nav-icon">🚪</span>
                        <span>خروج از حساب مدیریت</span>
                    </button>
                </form>
            </nav>

            <div class="admin-sidebar-footer">
                <div class="admin-user-pill">
                    <div class="admin-avatar">
                        <span>{{ admin_user.full_name|slice(0, 1)|default('A') }}</span>
                    </div>
                    <div class="admin-meta">
                        <strong>{{ admin_user.full_name|default('مدیر ارشد') }}</strong>
                        <small>دسترسی ادمین کل</small>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Workspace Area -->
        <div class="admin-main-wrap">
            <!-- Top Bar -->
            <header class="admin-topbar">
                <div class="admin-topbar-breadcrumb">
                    <a href="{{ url('admin/dashboard') }}">مدیریت</a> /
                    <span class="current">{{ page_title }}</span>
                </div>
                <div class="admin-topbar-actions">
                    <span class="admin-live-badge">🟢 سرور آنلاین (PHP 8.4)</span>
                    <a href="{{ url('/') }}" target="_blank" class="btn-visit-store">مشاهده آنلاین فروشگاه ↗</a>
                </div>
            </header>

            <!-- Content Area -->
            <main class="admin-content-area">
                {# Consolidated floating notifications / toasts #}
                {% set success_msgs = [] %}
                {% if flash_success %}
                    {% if flash_success is iterable %}
                        {% set success_msgs = flash_success %}
                    {% else %}
                        {% set success_msgs = flash_success|split("\n") %}
                    {% endif %}
                {% endif %}

                {% set error_msgs = [] %}
                {% if flash_error %}
                    {% if flash_error is iterable %}
                        {% set error_msgs = flash_error %}
                    {% else %}
                        {% set error_msgs = flash_error|split("\n") %}
                    {% endif %}
                {% endif %}

                {% if success_msgs is not empty or error_msgs is not empty %}
                    <div class="admin-toast-container" id="adminToastContainer" aria-live="polite">
                        {% for msg in success_msgs %}
                            {% if msg|trim %}
                                <div class="admin-toast admin-toast-success" role="alert">
                                    <div class="admin-toast-icon">✓</div>
                                    <div class="admin-toast-body">
                                        <span class="admin-toast-text">{{ msg|trim }}</span>
                                    </div>
                                    <button type="button" class="admin-toast-close" onclick="this.closest('.admin-toast').remove()" aria-label="بستن">✕</button>
                                </div>
                            {% endif %}
                        {% endfor %}

                        {% for msg in error_msgs %}
                            {% if msg|trim %}
                                <div class="admin-toast admin-toast-error" role="alert">
                                    <div class="admin-toast-icon">✕</div>
                                    <div class="admin-toast-body">
                                        <span class="admin-toast-text">{{ msg|trim }}</span>
                                    </div>
                                    <button type="button" class="admin-toast-close" onclick="this.closest('.admin-toast').remove()" aria-label="بستن">✕</button>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                {% block admin_content %}{% endblock %}
            </main>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const contentArea = document.querySelector('.admin-content-area');

        function initAdminToasts() {
            document.querySelectorAll('.admin-toast:not([data-initialized])').forEach(function(toast, index) {
                toast.setAttribute('data-initialized', 'true');
                setTimeout(function() {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(-12px) scale(0.96)';
                    setTimeout(function() { toast.remove(); }, 350);
                }, 4500 + (index * 400));
            });
        }
        initAdminToasts();

        if (!contentArea) return;

        async function loadAdminPage(url, push = true) {
            contentArea.classList.add('pjax-animating');

            try {
                const res = await fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-PJAX': 'true',
                        'Accept': 'application/json'
                    }
                });

                if (!res.ok) {
                    window.location.href = url;
                    return;
                }

                const data = await res.json();
                if (data && data.success && data.html !== undefined) {
                    contentArea.innerHTML = data.html;
                    if (data.title) {
                        document.title = data.title;
                        const breadcrumbCurrent = document.querySelector('.admin-topbar-breadcrumb .current');
                        if (breadcrumbCurrent) {
                            breadcrumbCurrent.textContent = data.title;
                        }
                    }

                    // Update active class on sidebar items
                    const currentUrlObj = new URL(url, window.location.origin);
                    const currentPath = currentUrlObj.pathname;
                    const activeMenu = data.active_menu;

                    document.querySelectorAll('.admin-nav .admin-nav-item').forEach(item => {
                        const href = item.getAttribute('href');
                        if (!href) return;
                        const itemUrlObj = new URL(href, window.location.origin);
                        if (itemUrlObj.pathname === currentPath || (activeMenu && itemUrlObj.pathname.endsWith('/' + activeMenu))) {
                            item.classList.add('active');
                        } else {
                            item.classList.remove('active');
                        }
                    });

                    if (push) {
                        history.pushState({ pjax: true, url: url }, '', url);
                    }

                    initAdminToasts();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else {
                    window.location.href = url;
                }
            } catch (err) {
                window.location.href = url;
            } finally {
                contentArea.classList.remove('pjax-animating');
            }
        }

        // Intercept sidebar link clicks
        document.addEventListener('click', function(e) {
            const link = e.target.closest('.admin-nav a.admin-nav-item:not(.admin-nav-logout):not([target="_blank"])');
            if (!link) return;

            const href = link.getAttribute('href');
            if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;

            e.preventDefault();
            loadAdminPage(href, true);
        });

        // Handle browser popstate
        window.addEventListener('popstate', function() {
            const path = window.location.pathname;
            if (path.includes('/admin/')) {
                loadAdminPage(window.location.href, false);
            }
        });
    });
    </script>

    {% block scripts %}{% endblock %}
</body>
</html>
