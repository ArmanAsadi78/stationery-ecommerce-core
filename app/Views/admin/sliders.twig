{% extends is_pjax ? 'layouts/blank.twig' : 'admin/layout.twig' %}

{% block admin_content %}
<div class="admin-sliders-view">
    <div class="admin-page-title-row" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h2>مدیریت بنرهای اسلایدر صفحه اصلی</h2>
            <p>بنرهای گرافیکی عریض و یکپارچه صفحه نخست (با نسبت استاندارد ۱۲۰۰x۴۲۰ و افکت تعاملی سه‌بعدی) را مدیریت، مرتب‌سازی و منتشر کنید.</p>
        </div>
        <div>
            <a href="{{ url('admin/sliders/create') }}" class="btn-admin-action" style="padding: 10px 22px; text-decoration: none;">
                <span>➕</span>
                <span>افزودن بنر اسلایدر جدید</span>
            </a>
        </div>
    </div>

    <!-- Sliders List Card -->
    <div class="admin-panel-card">
        <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <span>🖼️</span>
            <span>لیست بنرهای اسلایدر فعال و آرشیو ({{ sliders|length|fa_num }} مورد)</span>
        </h3>

        {% if sliders is empty %}
            <div style="text-align: center; padding: 48px 20px; color: #94a3b8;">
                <p style="font-size: 15px; margin-bottom: 16px;">هیچ بنری برای اسلایدر ثبت نشده است.</p>
                <a href="{{ url('admin/sliders/create') }}" class="btn-admin-action" style="padding: 9px 20px; text-decoration: none;">
                    ➕ بارگذاری اولین بنر اسلایدر
                </a>
            </div>
        {% else %}
            <div class="admin-table-responsive">
                <table class="admin-table admin-sliders-table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">ردیف</th>
                            <th style="width: 170px;">پیش‌نمایش بنر</th>
                            <th>عنوان بنر</th>
                            <th>آدرس مقصد کلیک (Target URL)</th>
                            <th style="width: 80px;">ترتیب</th>
                            <th style="width: 90px;">وضعیت</th>
                            <th style="width: 170px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for slider in sliders %}
                            <tr>
                                <td>{{ loop.index|fa_num }}</td>
                                <td>
                                    <div style="width: 150px; height: 53px; border-radius: 8px; overflow: hidden; background: #f8fafc; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(0,0,0,0.04);">
                                        <img src="{{ asset(slider.image_path|default(slider.image_url)) }}" alt="{{ slider.title }}" style="width: 100%; height: 100%; object-fit: cover;">
                                    </div>
                                </td>
                                <td>
                                    <strong style="display: block; font-size: 14px; color: #1e293b; margin-bottom: 4px;">{{ slider.title }}</strong>
                                    <small style="color: #64748b; font-size: 11px;">فایل: {{ slider.image_path|default(slider.image_url) }}</small>
                                </td>
                                <td>
                                    <a href="{{ url(slider.target_url|default(slider.link|default('/'))) }}" target="_blank" class="dir-ltr text-rose font-mono" style="font-size: 12px; text-decoration: underline;" title="مشاهده صفحه مقصد">
                                        {{ slider.target_url|default(slider.link|default('/')) }} ↗
                                    </a>
                                </td>
                                <td>
                                    <span class="font-bold">{{ slider.sort_order|fa_num }}</span>
                                </td>
                                <td>
                                    {% if slider.is_active == 1 %}
                                        <span class="admin-badge badge-green">فعال</span>
                                    {% else %}
                                        <span class="admin-badge badge-red">غیرفعال</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div style="display: flex; gap: 6px; align-items: center;">
                                        <!-- Toggle Status Form -->
                                        <form action="{{ url('admin/sliders/' ~ slider.id ~ '/toggle') }}" method="POST" style="display: inline;">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                                            <button type="submit" class="btn-admin-sm" title="تغییر وضعیت فعال/غیرفعال" style="cursor: pointer;">
                                                {% if slider.is_active == 1 %}
                                                    ⏸️
                                                {% else %}
                                                    ▶️
                                                {% endif %}
                                            </button>
                                        </form>

                                        <!-- Edit Modal Trigger -->
                                        <button type="button" class="btn-admin-sm" onclick="openSliderEditModal({{ slider.id }})" style="cursor: pointer;" title="ویرایش بنر">
                                            ✏️
                                        </button>

                                        <!-- Delete Form -->
                                        <form action="{{ url('admin/sliders/' ~ slider.id ~ '/delete') }}" method="POST" style="display: inline;" onsubmit="return confirm('آیا از حذف این بنر مطمئن هستید؟');">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                                            <button type="submit" class="btn-admin-sm" style="color: #ef4444; border-color: #fecaca; background: #fff5f5; cursor: pointer;" title="حذف بنر">
                                                🗑️
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Hidden Edit Dialog/Modal for this slider -->
                                    <dialog id="sliderEditModal-{{ slider.id }}" style="padding: 24px; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 20px 40px rgba(0,0,0,0.15); max-width: 600px; width: 90%; background: #ffffff; margin: auto;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                                            <h4 style="font-size: 16px; font-weight: 800; color: #1e293b; margin: 0;">ویرایش بنر اسلایدر #{{ slider.id|fa_num }}</h4>
                                            <button type="button" onclick="closeSliderEditModal({{ slider.id }})" style="background: none; border: none; font-size: 18px; cursor: pointer; color: #64748b;">✕</button>
                                        </div>

                                        <form action="{{ url('admin/sliders/' ~ slider.id ~ '/edit') }}" method="POST" enctype="multipart/form-data">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

                                            <div style="display: grid; gap: 14px; margin-bottom: 20px;">
                                                <div>
                                                    <label style="display: block; font-size: 12px; font-weight: 700; margin-bottom: 4px; color: #475569;">عنوان بنر *</label>
                                                    <input type="text" name="title" value="{{ slider.title }}" required class="admin-input-search" style="width: 100%;">
                                                </div>

                                                <div>
                                                    <label style="display: block; font-size: 12px; font-weight: 700; margin-bottom: 4px; color: #475569;">آدرس مقصد کلیک (Target URL) *</label>
                                                    <input type="text" name="target_url" value="{{ slider.target_url|default(slider.link|default('/')) }}" required class="admin-input-search dir-ltr" style="width: 100%;">
                                                </div>

                                                <div>
                                                    <label style="display: block; font-size: 12px; font-weight: 700; margin-bottom: 4px; color: #475569;">جایگزینی تصویر بنر (۱۲۰۰x۴۲۰)</label>
                                                    <input type="file" name="image" accept="image/webp,image/png,image/jpeg,image/gif" class="admin-input-search" style="width: 100%; padding: 6px 10px;">
                                                    <small style="color: #64748b; font-size: 11px;">در صورت عدم انتخاب، تصویر فعلی بنر حفظ می‌گردد.</small>
                                                </div>

                                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: center;">
                                                    <div>
                                                        <label style="display: block; font-size: 12px; font-weight: 700; margin-bottom: 4px; color: #475569;">ترتیب نمایش</label>
                                                        <input type="number" name="sort_order" value="{{ slider.sort_order }}" min="0" class="admin-input-search dir-ltr" style="width: 100%;">
                                                    </div>
                                                    <div style="padding-top: 18px;">
                                                        <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; cursor: pointer;">
                                                            <input type="checkbox" name="is_active" value="1" {% if slider.is_active == 1 %}checked{% endif %} style="width: 18px; height: 18px;">
                                                            <span>فعال باشد</span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                                                <button type="button" onclick="closeSliderEditModal({{ slider.id }})" class="btn-admin-sm" style="padding: 8px 16px;">انصراف</button>
                                                <button type="submit" class="btn-admin-action" style="padding: 8px 20px;">ذخیره تغییرات</button>
                                            </div>
                                        </form>
                                    </dialog>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>

<script>
function openSliderEditModal(id) {
    const modal = document.getElementById('sliderEditModal-' + id);
    if (modal && typeof modal.showModal === 'function') {
        modal.showModal();
    }
}
function closeSliderEditModal(id) {
    const modal = document.getElementById('sliderEditModal-' + id);
    if (modal && typeof modal.close === 'function') {
        modal.close();
    }
}
</script>
{% endblock %}
