<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title|default('ورود به پنل مدیریت | تحریرچی') }}</title>
    
    <!-- Vazirmatn Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="{{ asset('css/main.css') }}">
</head>
<body class="admin-login-body">
    <div class="admin-login-container">
        <div class="admin-login-card">
            <div class="admin-login-header">
                <div class="admin-shield-icon">🛡️</div>
                <h1>ورود به پرتال مدیریت سامانه</h1>
                <p>دسترسی منحصراً برای مدیران ارشد فروشگاه تحریرچی مجاز است.</p>
            </div>

            {% if error_message %}
                <div class="auth-alert error">
                    <span>✕ {{ error_message }}</span>
                </div>
            {% endif %}

            {% if success_message %}
                <div class="auth-alert success">
                    <span>✓ {{ success_message }}</span>
                </div>
            {% endif %}

            <form action="{{ url('admin/login') }}" method="POST" class="auth-form" id="adminLoginForm">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

                <div class="form-group">
                    <label for="adminEmail">ایمیل یا شناسه کاربری مدیریت</label>
                    <div class="input-with-icon">
                        <input type="text" id="adminEmail" name="identifier" class="form-input dir-ltr" placeholder="admin@tahrirchi.com" required autofocus>
                        <span class="input-icon">👤</span>
                    </div>
                </div>

                <div class="form-group">
                    <label for="adminPass">رمز عبور امنیتی</label>
                    <div class="input-with-icon password-toggle-box">
                        <input type="password" id="adminPass" name="password" class="form-input dir-ltr" placeholder="••••••••" required>
                        <button type="button" class="btn-toggle-password" id="toggleAdminPassBtn" aria-label="نمایش رمز">👁️</button>
                    </div>
                </div>

                <button type="submit" class="btn-admin-login-submit">
                    <span>ورود به داشبورد مدیریت</span>
                    <span>←</span>
                </button>
            </form>

            <div class="admin-login-footer">
                <a href="{{ url('/') }}">بازگشت به صفحه اصلی فروشگاه</a>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggleBtn = document.getElementById('toggleAdminPassBtn');
        const passInput = document.getElementById('adminPass');
        if (toggleBtn && passInput) {
            toggleBtn.addEventListener('click', function() {
                const isPass = passInput.type === 'password';
                passInput.type = isPass ? 'text' : 'password';
                toggleBtn.textContent = isPass ? '🔒' : '👁️';
            });
        }
    });
    </script>
</body>
</html>
