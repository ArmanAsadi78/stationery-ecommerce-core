{% extends 'admin/layout.twig' %}

{% block admin_content %}
<div class="admin-orders-view">
    <div class="admin-page-title-row">
        <div>
            <h2>مدیریت سفارش‌ها و رهگیری مرسولات</h2>
            <p>بررسی سفارش‌ها، تغییر وضعیت ارسال، چاپ فاکتور و ثبت کد رهگیری مرسولات پستی.</p>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="admin-toolbar-card">
        <!-- Status Filter Pills -->
        <div class="admin-filter-pills">
            <a href="{{ url('admin/orders') }}" class="admin-pill {% if current_status == '' %}active{% endif %}">
                همه سفارش‌ها
            </a>
            <a href="{{ url('admin/orders?status=processing') }}" class="admin-pill {% if current_status == 'processing' %}active{% endif %}">
                در حال پردازش / بسته‌بندی
            </a>
            <a href="{{ url('admin/orders?status=shipped') }}" class="admin-pill {% if current_status == 'shipped' %}active{% endif %}">
                تحویل شده به پست (ارسال‌شده)
            </a>
            <a href="{{ url('admin/orders?status=delivered') }}" class="admin-pill {% if current_status == 'delivered' %}active{% endif %}">
                تحویل نهایی به مشتری
            </a>
            <a href="{{ url('admin/orders?status=cancelled') }}" class="admin-pill {% if current_status == 'cancelled' %}active{% endif %}">
                لغو شده
            </a>
        </div>

        <!-- Search Form -->
        <form action="{{ url('admin/orders') }}" method="GET" class="admin-search-form">
            <input type="text" name="q" value="{{ search_query }}" placeholder="جستجوی شماره سفارش، نام یا تلفن گیرنده..." class="admin-input-search">
            {% if current_status %}
                <input type="hidden" name="status" value="{{ current_status }}">
            {% endif %}
            <button type="submit" class="btn-admin-search">🔍 جستجو</button>
            {% if search_query %}
                <a href="{{ url('admin/orders') }}" class="btn-clear-search">✕ پاک کردن</a>
            {% endif %}
        </form>
    </div>

    <!-- Orders Table Card -->
    <div class="admin-panel-card">
        {% if orders is empty %}
            <div class="admin-empty-state">
                <div class="empty-icon">📦</div>
                <h4>هیچ سفارشی با این شرایط پیدا نشد.</h4>
                <p>فیلترها یا عبارت جستجو را تغییر دهید.</p>
            </div>
        {% else %}
            <div class="admin-table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>شماره سفارش</th>
                            <th>گیرنده و شماره تماس</th>
                            <th>اقلام</th>
                            <th>مبلغ کل</th>
                            <th>وضعیت سفارش</th>
                            <th>کد رهگیری پستی / یادداشت</th>
                            <th>تاریخ ثبت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ord in orders %}
                            <tr>
                                <td>
                                    <strong class="dir-ltr text-rose">#{{ ord.order_number }}</strong>
                                </td>
                                <td>
                                    <strong>{{ ord.recipient_name }}</strong>
                                    <small class="block-sub dir-ltr">📞 {{ ord.recipient_phone }}</small>
                                </td>
                                <td>{{ ord.items_count|fa_num }} قلم</td>
                                <td>
                                    <strong>{{ ord.total_amount|price }} تومان</strong>
                                </td>
                                <td>
                                    {% if ord.status == 'delivered' %}
                                        <span class="admin-badge badge-green">تحویل شده</span>
                                    {% elseif ord.status == 'shipped' %}
                                        <span class="admin-badge badge-blue">ارسال شده با پست</span>
                                    {% elseif ord.status == 'processing' %}
                                        <span class="admin-badge badge-amber">در حال پردازش</span>
                                    {% elseif ord.status == 'cancelled' %}
                                        <span class="admin-badge badge-red">لغو شده</span>
                                    {% else %}
                                        <span class="admin-badge badge-gray">در انتظار پرداخت</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if ord.customer_notes %}
                                        <span class="tracking-snippet dir-ltr">{{ ord.customer_notes|slice(0, 30) }}</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="text-sm">{{ ord.created_at|slice(0, 16) }}</span>
                                </td>
                                <td>
                                    <a href="{{ url('admin/orders/' ~ ord.id) }}" class="btn-admin-manage">
                                        مدیریت و فاکتور ←
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if total_pages > 1 %}
                <div class="admin-pagination">
                    <div class="pagination-info">
                        <span>نمایش صفحه {{ current_page|fa_num }} از {{ total_pages|fa_num }} (مجموع {{ total_orders|fa_num }} سفارش)</span>
                    </div>
                    <div class="pagination-links">
                        {% if current_page > 1 %}
                            <a href="{{ url('admin/orders?page=' ~ (current_page - 1) ~ (current_status ? '&status=' ~ current_status : '') ~ (search_query ? '&q=' ~ search_query : '')) }}" class="btn-page-step">
                                → قبلی
                            </a>
                        {% endif %}

                        {% for p in 1..total_pages %}
                            {% if p == current_page %}
                                <span class="page-number active">{{ p|fa_num }}</span>
                            {% elseif p == 1 or p == total_pages or (p >= current_page - 2 and p <= current_page + 2) %}
                                <a href="{{ url('admin/orders?page=' ~ p ~ (current_status ? '&status=' ~ current_status : '') ~ (search_query ? '&q=' ~ search_query : '')) }}" class="page-number">{{ p|fa_num }}</a>
                            {% elseif p == current_page - 3 or p == current_page + 3 %}
                                <span class="page-ellipsis">...</span>
                            {% endif %}
                        {% endfor %}

                        {% if current_page < total_pages %}
                            <a href="{{ url('admin/orders?page=' ~ (current_page + 1) ~ (current_status ? '&status=' ~ current_status : '') ~ (search_query ? '&q=' ~ search_query : '')) }}" class="btn-page-step">
                                بعدی ←
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
