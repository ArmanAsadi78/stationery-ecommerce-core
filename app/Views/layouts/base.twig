<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>{{ page_title ? page_title : app_name }}</title>
    <meta name="description" content="{{ meta_description ? meta_description : 'فروشگاه اینترنتی لوازم‌التحریر تحریرچی، مرجع تخصصی خرید انواع نوشت‌افزار، لوازم اداری، طراحی و دفتر با بهترین قیمت.' }}">
    
    <!-- SEO & Canonical Link -->
    <link rel="canonical" href="{{ canonical_url ? canonical_url : url('', true) }}">
    <meta name="robots" content="index, follow">

    <!-- OpenGraph Social Meta Tags -->
    <meta property="og:site_name" content="{{ app_name }}">
    <meta property="og:locale" content="fa_IR">
    <meta property="og:type" content="{{ og_type ? og_type : 'website' }}">
    <meta property="og:title" content="{{ page_title ? page_title : app_name }}">
    <meta property="og:description" content="{{ meta_description ? meta_description : 'فروشگاه اینترنتی لوازم‌التحریر تحریرچی، مرجع تخصصی خرید انواع نوشت‌افزار، لوازم اداری، طراحی و دفتر با بهترین قیمت.' }}">
    <meta property="og:url" content="{{ canonical_url ? canonical_url : url('', true) }}">
    <meta property="og:image" content="{{ og_image ? og_image : asset('images/placeholder.webp', true) }}">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title ? page_title : app_name }}">
    <meta name="twitter:description" content="{{ meta_description ? meta_description : 'فروشگاه اینترنتی لوازم‌التحریر تحریرچی، مرجع تخصصی خرید انواع نوشت‌افزار، لوازم اداری، طراحی و دفتر با بهترین قیمت.' }}">
    <meta name="twitter:image" content="{{ og_image ? og_image : asset('images/placeholder.webp', true) }}">
    
    <!-- Google Fonts Preconnect & Vazirmatn Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Modern Main Stylesheet -->
    <link rel="stylesheet" href="{{ asset('css/main.css') }}">
    
    {% block head %}{% endblock %}
</head>
<body>
    <!-- Site Header -->
    <header class="site-header">
        <div class="container">
            <div class="top-bar">
                <!-- Brand Logo -->
                <a href="{{ url('/') }}" class="brand-logo" title="صفحه اصلی تحریرچی">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                    </svg>
                    <span>تحریرچی</span>
                </a>

                <!-- Search Input -->
                <form action="{{ url('products') }}" method="GET" class="header-search">
                    <input type="text" name="q" placeholder="جستجوی خودکار، روان‌نویس، اتود، دفتر، برند..." value="{{ search_query|default('') }}" autocomplete="off">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </form>

                <!-- Actions / Cart Button -->
                <div class="header-actions">
                    <button type="button" class="cart-btn-trigger" aria-label="مشاهده سبد خرید">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                        <span>سبد خرید</span>
                        <span id="headerCartBadge" class="cart-badge {% if cart_count > 0 %}has-items{% endif %}">{{ cart_count|fa_num }}</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Categories Navigation Bar with Premium Mega Menu -->
        <nav class="nav-bar">
            <div class="container nav-container">
                <ul class="nav-links">
                    <!-- Mega Menu Dropdown Trigger -->
                    <li class="nav-item-mega">
                        <a href="{{ url('products') }}" class="mega-trigger">
                            <svg class="nav-menu-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
                            </svg>
                            <span>دسته‌بندی کالاها</span>
                            <svg class="chevron-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </a>

                        <!-- Wide Premium Mega Menu Panel -->
                        <div class="mega-menu-dropdown" aria-label="منوی جامع دسته‌بندی‌ها">
                            <div class="mega-menu-inner">
                                <div class="mega-columns">
                                    <!-- Column 1: نوشت‌افزار -->
                                    <div class="mega-col">
                                        <a href="{{ url('products?category=writing-instruments') }}" class="mega-col-header">
                                            <span class="mega-icon-circle icon-pink">✏️</span>
                                            <span class="mega-col-title">نوشت‌افزار و قلم</span>
                                        </a>
                                        <ul class="mega-col-list">
                                            <li><a href="{{ url('products?category=rollerball-pens') }}">روان‌نویس و خودنویس</a></li>
                                            <li><a href="{{ url('products?category=mechanical-pencils') }}">اتود و مداد نوکی</a></li>
                                            <li><a href="{{ url('products?category=writing-instruments') }}">ماژیک و هایلایتر پاستلی</a></li>
                                            <li><a href="{{ url('products?category=writing-instruments') }}">خودکار فانتزی و چندرنگ</a></li>
                                            <li><a href="{{ url('products?category=writing-instruments') }}">پاک‌کن و غلط‌گیر</a></li>
                                        </ul>
                                    </div>

                                    <!-- Column 2: کاغذ و دفتر -->
                                    <div class="mega-col">
                                        <a href="{{ url('products?category=notebooks-and-paper') }}" class="mega-col-header">
                                            <span class="mega-icon-circle icon-lavender">📓</span>
                                            <span class="mega-col-title">دفتر، کاغذ و پلنر</span>
                                        </a>
                                        <ul class="mega-col-list">
                                            <li><a href="{{ url('products?category=notebooks-and-paper') }}">دفتر مشق و خط‌دار</a></li>
                                            <li><a href="{{ url('products?category=notebooks-and-paper') }}">بولت ژورنال و نقطه‌ای</a></li>
                                            <li><a href="{{ url('products?category=notebooks-and-paper') }}">پلنر و دفتر برنامه‌ریزی</a></li>
                                            <li><a href="{{ url('products?category=notebooks-and-paper') }}">کاغذ یادداشت و استیکی نوت</a></li>
                                            <li><a href="{{ url('products?category=notebooks-and-paper') }}">کلاسور، زونکن و یدک</a></li>
                                        </ul>
                                    </div>

                                    <!-- Column 3: لوازم اداری و بایگانی -->
                                    <div class="mega-col">
                                        <a href="{{ url('products?category=office-supplies') }}" class="mega-col-header">
                                            <span class="mega-icon-circle icon-butter">📎</span>
                                            <span class="mega-col-title">لوازم اداری و بایگانی</span>
                                        </a>
                                        <ul class="mega-col-list">
                                            <li><a href="{{ url('products?category=office-supplies') }}">زونکن و کلربوک اداری</a></li>
                                            <li><a href="{{ url('products?category=office-supplies') }}">منگنه، پانچ و سوزن‌کش</a></li>
                                            <li><a href="{{ url('products?category=office-supplies') }}">پایه‌چسب و چسب واشی</a></li>
                                            <li><a href="{{ url('products?category=office-supplies') }}">قیچی، کاتر و تیغ برش</a></li>
                                            <li><a href="{{ url('products?category=office-supplies') }}">ارگانایزر و نظم‌دهنده رومیزی</a></li>
                                        </ul>
                                    </div>

                                    <!-- Column 4: هنر و نقاشی -->
                                    <div class="mega-col">
                                        <a href="{{ url('products?category=art-and-drawing') }}" class="mega-col-header">
                                            <span class="mega-icon-circle icon-mint">🎨</span>
                                            <span class="mega-col-title">طراحی، نقاشی و هنر</span>
                                        </a>
                                        <ul class="mega-col-list">
                                            <li><a href="{{ url('products?category=art-and-drawing') }}">مدادرنگی‌های تخصصی</a></li>
                                            <li><a href="{{ url('products?category=art-and-drawing') }}">آبرنگ، گواش و قلم‌مو</a></li>
                                            <li><a href="{{ url('products?category=art-and-drawing') }}">راپید و روان‌نویس مهندسی</a></li>
                                            <li><a href="{{ url('products?category=art-and-drawing') }}">دفتر طراحی و مقوای ضخیم</a></li>
                                            <li><a href="{{ url('products?category=art-and-drawing') }}">پاستل گچی و روغنی</a></li>
                                        </ul>
                                    </div>
                                </div>

                                <!-- Mega Menu Featured Side Promo -->
                                <div class="mega-promo-box">
                                    <div class="mega-promo-badge">پیشنهاد برگزیده ✨</div>
                                    <h4 class="mega-promo-heading">کالکشن بهاره نوشت‌افزار</h4>
                                    <p class="mega-promo-text">محبوب‌ترین ست‌های تحریر، ژورنال و هایلایتر با ضمانت اصالت ۱۰۰٪ فیزیکی</p>
                                    <a href="{{ url('products') }}" class="mega-promo-action">
                                        <span>مشاهده شگفت‌انگیزها</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </li>

                    <li><a href="{{ url('/') }}">صفحه اصلی</a></li>
                    <li><a href="{{ url('products?category=writing-instruments') }}">نوشت‌افزار</a></li>
                    <li><a href="{{ url('products?category=notebooks-and-paper') }}">دفتر و کاغذ</a></li>
                    <li><a href="{{ url('products?category=art-and-drawing') }}">طراحی و نقاشی</a></li>
                    <li><a href="{{ url('about-us') }}">درباره ما</a></li>
                    <li><a href="{{ url('contact-us') }}">تماس با ما</a></li>
                </ul>

                <!-- Hot Deals Quick Link on Nav Bar -->
                <div class="nav-deals-wrap">
                    <a href="{{ url('products') }}" class="nav-hot-deals">
                        <span class="deals-fire">🔥</span>
                        <span>تخفیف‌های شگفت‌انگیز</span>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Block -->
    <main class="site-main">
        {% block content %}{% endblock %}
    </main>

    <!-- Drawer Cart Component -->
    {% include 'layouts/drawer-cart.twig' %}

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container" aria-live="polite"></div>

    <!-- Site Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-features">
                <div class="footer-feature-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <div>
                        <h4>ارسال سریع به سراسر کشور</h4>
                        <p>بسته‌بندی ایمن و ارسال با پست پیشتاز و تیپاکس</p>
                    </div>
                </div>
                <div class="footer-feature-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <div>
                        <h4>ضمانت ۱۰۰٪ اصالت کالا</h4>
                        <p>تضمین بازگشت وجه در صورت عدم اصالت نوشت‌افزار</p>
                    </div>
                </div>
                <div class="footer-feature-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                    <div>
                        <h4>پرداخت آنلاین امن</h4>
                        <p>اتصال به درگاه‌های معتبر بانکی شتاب</p>
                    </div>
                </div>
                <div class="footer-feature-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    <div>
                        <h4>پشتیبانی تخصصی</h4>
                        <p>مشاوره در خرید انواع قلم و نوشت‌افزار مهندسی</p>
                    </div>
                </div>
            </div>

            <!-- Main Footer Links Columns -->
            <div class="footer-main-grid">
                <div class="footer-col-brand">
                    <div class="brand-logo" style="margin-bottom: 12px;">
                        <span>تحریرچی</span>
                    </div>
                    <p class="footer-brand-desc">
                        تحریرچی، مرجع تخصصی خرید آنلاین زیباترین و باکیفیت‌ترین نوشت‌افزارهای جهان. تضمین ۱۰۰٪ اصالت فیزیکی، بسته‌بندی هاردباکس ایمن و ارسال سریع به سراسر ایران.
                    </p>
                    <div class="footer-contact-snippets">
                        <span>📞 پشتیبانی: ۰۲۱-۸۸۸۸۴۳۲۱</span>
                        <span>✉️ ایمیل: support@tahrirchi.com</span>
                    </div>
                </div>

                <div class="footer-col-links">
                    <h4 class="footer-col-heading">دسترسی سریع</h4>
                    <ul class="footer-links-list">
                        <li><a href="{{ url('/') }}">صفحه اصلی</a></li>
                        <li><a href="{{ url('products') }}">تمامی محصولات</a></li>
                        <li><a href="{{ url('about-us') }}">درباره تحریرچی</a></li>
                        <li><a href="{{ url('contact-us') }}">تماس با ما</a></li>
                        <li><a href="{{ url('sitemap.xml') }}" target="_blank">نقشه سایت (XML)</a></li>
                    </ul>
                </div>

                <div class="footer-col-links">
                    <h4 class="footer-col-heading">خدمات و قوانین</h4>
                    <ul class="footer-links-list">
                        <li><a href="{{ url('faq') }}">سوالات متداول (FAQ)</a></li>
                        <li><a href="{{ url('terms') }}">قوانین و مقررات خرید</a></li>
                        <li><a href="{{ url('terms') }}">رویه ضمانت بازگشت ۷ روزه</a></li>
                        <li><a href="{{ url('terms') }}">سیاست حفظ حریم خصوصی</a></li>
                        <li><a href="{{ url('contact-us') }}">ثبت شکایات و پیشنهادات</a></li>
                    </ul>
                </div>

                <div class="footer-col-trust">
                    <h4 class="footer-col-heading">مجوزها و اعتماد</h4>
                    <p class="footer-trust-text">دارای کلیه مجوزهای لازم از مراجع ذی‌صلاح و نماد اعتماد الکترونیکی.</p>
                    <div class="footer-trust-badges">
                        <div class="trust-badge-symbol" title="نماد اعتماد الکترونیکی اینماد">
                            <span class="symbol-icon">🛡️</span>
                            <small>اینماد ۵ ستاره</small>
                        </div>
                        <div class="trust-badge-symbol" title="نشان ملی ثبت رسانه‌های دیجیتال">
                            <span class="symbol-icon">⚖️</span>
                            <small>ساماندهی</small>
                        </div>
                        <div class="trust-badge-symbol" title="درگاه پرداخت امن شاپرک">
                            <span class="symbol-icon">🔒</span>
                            <small>پرداخت امن</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>© {{ "now"|date("Y") }} تمامی حقوق مادی و معنوی برای <strong>{{ app_name }}</strong> محفوظ است. طراحی شده با Clean Architecture و فریم‌ورک بومی PHP.</p>
            </div>
        </div>
    </footer>

    <!-- Vanilla AJAX Cart Script -->
    <script src="{{ asset('js/cart.js') }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
