# Application Configuration
APP_NAME="فروشگاه لوازم‌التحریر تحریرچی"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=base64:generate_secure_random_key_here_for_csrf_and_sessions

# Database Connection (WAMP / Localhost defaults)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stationery_shop
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Production Database (Optional override for online host / InfinityFree)
# DB_PROD_HOST=sql311.infinityfree.com
# DB_PROD_PORT=3306
# DB_PROD_DATABASE=if0_43356455_stationery
# DB_PROD_USERNAME=if0_43356455
# DB_PROD_PASSWORD=your_vpanel_password_here

# Session & Security
SESSION_LIFETIME=259200
SESSION_SECURE_COOKIE=false
SESSION_COOKIE_SAMESITE=Lax

# Payment Gateway (Zarinpal)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost/payment/callback

# Torob Integration Settings
TOROB_API_TOKEN=torob_secure_api_token_stationery_2026
TOROB_CACHE_TTL=3600
TOROB_PAGE_SIZE=100

# File Storage & Uploads
UPLOAD_MAX_FILESIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
AUTO_CONVERT_WEBP=true
